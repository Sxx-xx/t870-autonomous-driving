<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>t870_control</name>
  <version>0.1.0</version>
  <description>Henes Broon T870 vehicle control package using Pixhawk and ArduRover</description>
  <maintainer email="eunjae@todo.todo">eunjae</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>mavros_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>vehicle_msgs</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <exec_depend>python3-pyserial</exec_depend>
  <exec_depend>python3-pyproj</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
