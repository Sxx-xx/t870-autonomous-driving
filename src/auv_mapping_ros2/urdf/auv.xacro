<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="auv">

  <!-- Constants -->
  <xacro:property name="body_mass" value="12.0" />
  <xacro:property name="body_radius" value="0.15" />
  <xacro:property name="body_length" value="1.0" />

  <!-- Base Link (Body) -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="${body_radius}" length="${body_length}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${body_radius}" length="${body_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${body_mass}"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>

  <!-- Sonar Link -->
  <link name="sonar_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="sonar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sonar_link"/>
    <origin xyz="0 0 -${body_radius}" rpy="0 1.5707 0"/>
  </joint>

  <!-- Gazebo Plugins -->
  <gazebo reference="base_link">
    <plugin name="buoyancy" filename="libbuoyancy_gazebo_plugin.so">
        <fluid_density>1025</fluid_density>
        <volume>${3.14159265 * body_radius * body_radius * body_length}</volume>
        <center_of_volume>0 0 0</center_of_volume>
        <buoyancy_force_topic>/buoyancy_force</buoyancy_force_topic>
    </plugin>
    <plugin name="drag" filename="libdrag_gazebo_plugin.so">
        <drag_coefficient>0.8</drag_coefficient>
        <area>${body_radius * 2 * body_length}</area>
        <fluid_density>1025</fluid_density>
    </plugin>
  </gazebo>

  <!-- Gazebo Sonar Sensor (for Gazebo Garden) -->
  <gazebo reference="sonar_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
        <topic>/sonar_scan</topic>
        <update_rate>10</update_rate>
        <ray>
            <scan>
                <horizontal>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>0.0</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0.0</min_angle>
                    <max_angle>0.0</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.5</min>
                <max>50.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
        <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
